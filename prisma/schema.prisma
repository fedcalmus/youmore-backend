generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  SUPER_ADMIN
}

model FinancingEntity {
  id        Int      @id @default(autoincrement())
  name      String
  image     String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id          Int      @id @default(autoincrement())
  name        String
  surname     String
  email       String
  phoneNumber String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum StaticPageKey {
  TERMS_AND_CONDITIONS
  COOKIES
  ABOUT_US
}

model StaticPage {
  id        Int           @id @default(autoincrement())
  key       StaticPageKey @unique
  content   String        @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ContactInfo {
  id        Int      @id @default(autoincrement())
  address   String
  phone     String
  email     String
  instagram String?
  facebook  String?
  linkedin  String?
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

model Project {
  id               Int           @id @default(autoincrement())
  title            String
  slug             String        @unique
  shortDescription String
  description      String        @db.Text
  mainImage        String
  documentUrl      String?
  projectCode      String?
  category         String?
  status           ProjectStatus @default(ACTIVE)
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  beneficiaries    String?       @db.Text
  funding          String?       @db.Text
  richContent      Json?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  volunteerApplications VolunteerApplication[]

  @@index([slug])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TshirtSize {
  XS
  S
  M
  L
  XL
  XXL
}

model VolunteerApplication {
  id                            Int        @id @default(autoincrement())
  project                       Project    @relation(fields: [projectId], references: [id])
  projectId                     Int
  name                          String
  surname                       String
  gender                        Gender
  citizenship                   String
  city                          String
  dateOfBirth                   DateTime
  email                         String
  phoneNumber                   String
  hasPassport                   Boolean
  travelDocumentValidForCountry Boolean
  motivation                    String     @db.Text
  isFirstExperience             Boolean
  howDidYouFindUs               String
  emergencyContact              String
  specialNeeds                  String?    @db.Text
  tshirtSize                    TshirtSize
  emailGroupConsent             Boolean
  personalDataConsent           Boolean
  consentTimestamp              DateTime   @default(now())
  createdAt                     DateTime   @default(now())

  @@index([projectId])
  @@index([email])
  @@index([createdAt])
}
